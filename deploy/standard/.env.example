# mr-review — standard deployment (2 containers)
# Copy this file to .env and adjust values as needed.
#
# Usage:
#   cp .env.example .env
#   docker compose up -d
#   open http://localhost:17242
#
# Compose reads this file only to substitute ${...} in docker-compose.yml, so
# the three variables below are the only ones it does anything with. Application
# settings (MR_REVIEW__*) are read from the container's environment: to change
# one, add it to the "environment:" block of the api service.

# Port where the web UI will be available
WEB_PORT=17242

# Port where the API will be available
API_PORT=17241

# Directory on the host where application data is stored: hosts.yaml,
# ai_providers.yaml and one YAML file per review. It holds host tokens and
# provider API keys in plain text — keep it private.
# Use an absolute path for server deployments, e.g. /opt/mr-review/data
DATA_DIR=./data
