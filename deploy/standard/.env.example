# mr-review — standard deployment (2 containers)
# Copy this file to .env and adjust values as needed.
#
# Usage:
#   cp .env.example .env
#   docker compose up -d
#   open http://localhost:17242
#
# Compose reads this file only to substitute ${...} in docker-compose.yml, so
# the variables below are the only ones it does anything with. Application
# settings (MR_REVIEW__*) are read from the container's environment: to change
# one, add it to the "environment:" block of the api service.

# Address both ports are published on. The default, 127.0.0.1, makes the app
# reachable from this machine only.
#
# WARNING: mr-review has no login. Anyone who can open either port can read
# every stored VCS token and AI API key (POST /api/v1/data/export) and post
# comments under your tokens. Set 0.0.0.0 to publish them on every network
# interface only on a network where you trust everyone, or put an
# authenticating reverse proxy in front of the web port instead.
MR_REVIEW_BIND=127.0.0.1

# Port where the web UI will be available. The UI reaches the API through it
# (under /api/), so this is the only port a browser needs.
WEB_PORT=17242

# Port where the API is published directly, for scripts and /system/docs
API_PORT=17241

# Directory on the host where application data is stored: hosts.yaml,
# ai_providers.yaml and one YAML file per review. It holds host tokens and
# provider API keys in plain text — keep it private.
# Use an absolute path for server deployments, e.g. /opt/mr-review/data
DATA_DIR=./data

# The user the API runs as and owns DATA_DIR. The container starts as root,
# hands DATA_DIR to PUID:PGID, then drops to that user. Set them to the output
# of `id -u` / `id -g` to keep the files owned by you on the host.
PUID=1000
PGID=1000
