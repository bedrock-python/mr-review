# mr-review — all-in-one deployment (single container)
# Copy this file to .env and adjust values as needed.
#
# Usage:
#   cp .env.example .env
#   docker compose up -d
#   open http://localhost:17240
#
# Compose reads this file only to substitute ${...} in docker-compose.yml, so
# the variables below are the only ones it does anything with. Application
# settings (MR_REVIEW__*) are read from the container's environment: to change
# one, add it to the "environment:" block of docker-compose.yml.

# Address the port is published on. The default, 127.0.0.1, makes the app
# reachable from this machine only.
#
# WARNING: mr-review has no login. Anyone who can open the port can read every
# stored VCS token and AI API key (POST /api/v1/data/export) and post comments
# under your tokens. Set 0.0.0.0 to publish it on every network interface only
# on a network where you trust everyone, or put an authenticating reverse proxy
# in front of it instead.
MR_REVIEW_BIND=127.0.0.1

# Port where the app (UI + API) will be available
PORT=17240

# Directory on the host where application data is stored: hosts.yaml,
# ai_providers.yaml and one YAML file per review. It holds host tokens and
# provider API keys in plain text — keep it private.
# Use an absolute path for server deployments, e.g. /opt/mr-review/data
DATA_DIR=./data

# The user the application runs as and owns DATA_DIR. The container starts as
# root, hands DATA_DIR to PUID:PGID, then drops to that user. Set them to the
# output of `id -u` / `id -g` to keep the files owned by you on the host.
PUID=1000
PGID=1000
