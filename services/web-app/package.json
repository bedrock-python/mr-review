    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.15.4",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "pnpm": {
    "//": "expect-type@1.x ships CJS but lacks an `exports` map and `type` field, so Node's ESM resolver (used by vitest>=3.x) fails to load it via pnpm's symlinked layout on Windows with ERR_MODULE_NOT_FOUND from legacyMainResolve. The patch in patches/expect-type@1.4.0.patch adds an explicit `exports` map + `type: commonjs` so the resolver treats it as a proper CJS package boundary. Remove once upstream ships an `exports` field (track at https://github.com/mmkal/expect-type/issues). See docs/troubleshooting/vitest-expect-type.md for diagnosis + bump procedure.",
    "patchedDependencies": {
      "expect-type@1.4.0": "patches/expect-type@1.4.0.patch"
    },
    "//overrides": "@storybook/addon-actions pins uuid@9, which carries GHSA-w5hq-g745-h8pq (missing buffer bounds check in v3/v5/v6). Storybook only calls v4() without a buffer, but the alert stays open until the dependency moves. Drop this override once Storybook ships a release that depends on uuid>=11.1.1.",
    "overrides": {
      "uuid@9": "^11.1.1"
    }
  }
}
